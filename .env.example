# =============================================================================
# Fastify API (onyxx-backend/) — local dev + DigitalOcean *API* app
# =============================================================================

# Local: 4000. Production: DigitalOcean sets PORT=8080 (match http_port in .do/app.yaml).
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# REQUIRED — must match JWT_SECRET in the repo root .env (Next admin cookie).
JWT_SECRET=use-a-long-random-string
# ADMIN_SESSION_SECRET=use-a-long-random-string

# Browser origins allowed to call POST /api/applications (comma-separated, no trailing slashes).
# http://localhost:3000 and https://afreshmodeling.com are always allowed by default.
# Add your deployed *frontend* URL(s), e.g. https://your-web.ondigitalocean.app
CORS_ORIGINS=http://localhost:3000,https://afreshmodeling.com,https://www.afreshmodeling.com

# Marketing site for branded emails (logo URL). Your *frontend* URL — not this API host.
# PUBLIC_SITE_URL=https://afreshmodeling.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=afresh

# Application status emails (shortlist / reject)
RESEND_API_KEY=
RESEND_FROM=AfrESH Modeling <freshmodeling@gmail.com>
